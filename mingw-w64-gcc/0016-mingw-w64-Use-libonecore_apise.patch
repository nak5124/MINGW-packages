From eda1b15d6c48cc4434f697303963f582c4e6c08a Mon Sep 17 00:00:00 2001
From: Yuta Nakai <nak5124@live.jp>
Date: Mon, 11 Nov 2024 01:14:39 +0900
Subject: [PATCH] mingw-w64: Use libonecore_apise.

---
 gcc/config/i386/mingw-w64.h  | 4 ++--
 libgcc/config/i386/t-mingw32 | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/gcc/config/i386/mingw-w64.h b/gcc/config/i386/mingw-w64.h
index 951543438b7..6e76b8f92ad 100644
--- a/gcc/config/i386/mingw-w64.h
+++ b/gcc/config/i386/mingw-w64.h
@@ -57,7 +57,7 @@ along with GCC; see the file COPYING3.  If not see
   "%{mthreads:-lmingwthrd} -lmingw32 \
    " SHARED_LIBGCC_SPEC " \
    -lmingwex %{!mcrtdll=*:-lucrt} %{mcrtdll=*:-l%*} \
-   -lkernel32 " MCFGTHREAD_SPEC
+   -lonecore_apiset " MCFGTHREAD_SPEC
 
 #undef STARTFILE_SPEC
 #define STARTFILE_SPEC "%{shared|mdll:dllcrt2%O%s} \
@@ -80,7 +80,7 @@ along with GCC; see the file COPYING3.  If not see
 		 "%{mwindows:-lgdi32 -lcomdlg32} " \
      "%{fvtable-verify=preinit:-lvtv -lpsapi; \
         fvtable-verify=std:-lvtv -lpsapi} " \
-		 "-ladvapi32 -lshell32 -luser32 -lkernel32"
+		 "-lonecore_apiset"
 
 #undef SPEC_32
 #undef SPEC_64
diff --git a/libgcc/config/i386/t-mingw32 b/libgcc/config/i386/t-mingw32
index f250688fe1b..3c1b8853b9e 100644
--- a/libgcc/config/i386/t-mingw32
+++ b/libgcc/config/i386/t-mingw32
@@ -1,2 +1,2 @@
 # MinGW-specific parts of LIB_SPEC
-SHLIB_LC = -lmingwthrd -lmingw32 -lmingwex -lucrt -ladvapi32 -lshell32 -luser32 -lkernel32
+SHLIB_LC = -lmingwthrd -lmingw32 -lmingwex -lucrt -lonecore_apiset
-- 
2.47.0

